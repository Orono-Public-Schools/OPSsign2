<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Athletic Schedule</title>
    <script src="/js/schedule-template.js"></script>

    <style>
        /* Main layout structure */
        body {
            margin: 0;
            padding: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .schedule-header {
            background: #00284d;
            color: white;
            padding: 20px;
            text-align: center;
            flex-shrink: 0;
        }

        .schedule-header h1 {
            margin: 0;
            font-size: 2.5em;
        }

        .flex-layout {
            flex: 1;
            display: flex;
            overflow: hidden;
            min-height: 0;
        }

        .main-content {
            width: 100% !important;
            margin-left: 0 !important;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
        }

        /* Force sidebar modules to stack vertically */
        .rotating-module {
            display: none;
            flex-direction: column;
            height: 100%;
        }

        .rotating-module h2 {
            display: block;
            margin: 0 0 15px 0;
            padding: 0;
            width: 100%;
            flex-shrink: 0;
        }

        .rotating-module > div[data-module] {
            flex: 1;
            min-height: 0;
            width: 100%;
        }

        /* Slides Container - should not affect layout when hidden */
        #slideContainer {
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0;
            left: 0;
            display: none;
        }

        #slideContainer.hidden {
            display: none !important;
        }

       /* Override sidebar layout constraints - force full width */
        .schedule-container {
            width: 100% !important;
            max-width: 100% !important;
        }

        #scheduleContent {
            width: 100% !important;
            max-width: 100% !important;
        }

        .schedule-content {
            width: 100% !important;
            max-width: 100% !important;
            padding: 30px 50px !important;
        }

        .event-group {
            width: 100% !important;
        }

        .date-header {
            font-size: 1.5em;
            font-weight: bold;
            color: var(--primary-color, #003366);
            margin-bottom: 10px;  /* Reduced from 15px */
            padding-bottom: 8px;
            border-bottom: 3px solid var(--primary-color, #003366);
        }

        /* Event layout - make events flow horizontally */
        .time-group {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
            align-items: flex-start;
        }

        .time-box {
            flex-shrink: 0;
            width: 90px;
            text-align: center;
            padding: 12px 10px;
            background: #00284d;
            color: white;
            border-radius: 8px;
            font-size: 1.4em;
            font-weight: bold;
        }

        .events-at-time {
            flex: 1;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
            gap: 20px;
        }

        .event-card {
            background: #ffffff;
            color: #333333;
            border-radius: 8px;
            padding: 15px 20px;
            box-shadow: 0 3px 8px rgba(0, 0, 0, 0.12);
        }

        .event-title {
            font-size: 1.2em;  /* Reduced from 1.4em */
            font-weight: bold;
            margin-bottom: 4px;
            color: var(--primary-color, #003366);
            line-height: 1.3;
        }

        .event-opponent {
            font-size: 1em;
            font-weight: 600;
            color: #555;
            margin-bottom: 6px;
        }

        .event-location {
            font-size: 0.9em;  /* Reduced from 1em */
            color: #666;
            margin-bottom: 3px;
        }

        .event-location::before {
            content: "📍 ";
        }

        .event-address {
            font-size: 0.85em;  /* Reduced from 0.9em */
            color: #999;
            margin-top: 3px;
        }

        .event-address::before {
            content: "📍 ";
        }

        #info-bar {
            background: #00284d;
            color: white;
            padding: 15px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-shrink: 0;
            min-height: 70px;
            gap: 30px;
        }

        .building-card {
            background-color: #fff;
            border-radius: 6px;
            overflow: visible;
            display: flex;
            flex-direction: row; /* Changed from column to row */
            align-items: center; /* Center vertically */
            gap: 12px; /* Space between logo and text */
            border: 3px solid #fff;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
            padding: 8px 15px; /* Add padding around the whole card */
            max-height: 65px; /* Can be shorter now */
        }

        .building-logo {
            max-width: 140px;
            max-height: 50px;
            width: auto;
            height: auto;
            padding: 0; /* Remove padding - card has it now */
            background-color: transparent; /* Logo sits on white card */
        }

        .building-name {
            font-size: 1.3em;
            font-weight: 600;
            color: #fff; /* White text */
            background-color: #00284d; /* Blue background */
            padding: 8px 16px; /* Add padding back */
            margin: 0;
            text-align: center;
            white-space: nowrap;
            line-height: 1;
            border-radius: 4px; /* Optional: rounded corners for the blue box */
        }

        .info-left {
            flex-shrink: 0;
        }

        #info-date {
            flex: 1;
            text-align: center;
            font-size: 1.8em;
            font-weight: 500;
        }

        #info-weather {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.5em;
            font-weight: bold;
        }

        #info-time {
            font-size: 1.8em;
            font-weight: bold;
            min-width: 120px;
            text-align: right;
        }

        .weather-icon {
            height: 50px;
            width: auto;
        }
    </style>
</head>
<body>
    <!-- Header outside everything -->
    <div class="schedule-header">
        <h1>Athletic Schedule</h1>
    </div>

    <div class="flex-layout">
        <div class="main-content" style="width: 100%; margin-left: 0;">
            <!-- Athletic Schedule -->
            <div class="schedule-container" id="scheduleContainer">
                <div class="loading-state" id="loadingState">
                    <div class="spinner"></div>
                    <h2>Loading Athletic Schedule...</h2>
                </div>

                <div class="error-state" id="errorState">
                    <div style="font-size: 3em; margin-bottom: 15px;">⚠️</div>
                    <h2>Unable to Load Schedule</h2>
                    <p>Please check your connection</p>
                </div>

                <div id="scheduleContent" style="display: none; height: 100%; display: flex; flex-direction: column;">
                    <div class="schedule-content" id="eventsList"></div>
                </div>
            </div>

            <!-- Slides (for rotation mode) -->
            <div id="slideContainer"></div>
        </div>
    </div>

    <!-- Info bar outside flex-layout -->
    <div id="info-bar">
        <div class="info-left">
            <div class="building-card">
                <img src="/assets/OPS_banner_v1.png" alt="Orono Schools Logo" class="building-logo">
                <div class="building-name">{BUILDING_NAME}</div>
            </div>
        </div>
        
        <div id="info-date"></div>
        
        <div style="display: flex; gap: 30px; align-items: center;">
            <div id="info-weather"></div>
            <div id="info-time"></div>
        </div>
    </div>

</body>
</html>