<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Athletic Schedule</title>
    <link rel="stylesheet" href="/css/modules.css">
    <link rel="stylesheet" href="/css/layout-sidebar.css">
    <script src="/js/schedule-bound.js"></script>

    <style>
    /* Force sidebar modules to stack vertically */
        /* Force sidebar modules to stack vertically */
        .rotating-module {
            display: none;
            flex-direction: column;
            height: 100%;
        }

        .rotating-module h2 {
            display: block;
            margin: 0 0 15px 0;
            padding: 0;
            width: 100%;
            flex-shrink: 0;
        }

        .rotating-module > div[data-module] {
            flex: 1;
            min-height: 0;
            width: 100%;
        }

        /* Schedule-specific styles */
        .schedule-container {
            display: flex !important;  /* FORCE VISIBLE for debugging */
            flex-direction: column;
            height: 100%;
            overflow-y: auto;
            background: #f5f5f5;
            color: #333333;
        }

        .schedule-container.active {
            display: flex;
        }

        .schedule-content {
            flex: 1;
            min-height: 0;
            overflow-y: auto;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            padding: 20px;
            align-items: start;
        }

        .event-group {
            margin-bottom: 0;
        }

        .date-header {
            font-size: 1.5em;
            font-weight: bold;
            color: var(--primary-color, #003366);
            margin-bottom: 10px;  /* Reduced from 15px */
            padding-bottom: 8px;
            border-bottom: 3px solid var(--primary-color, #003366);
        }

        .time-group {
            display: flex;
            gap: 15px;
            margin-bottom: 15px;
            align-items: flex-start;
        }

        .time-box {
            flex-shrink: 0;
            width: 80px;  /* Reduced from 100px */
            text-align: center;
            padding: 10px 8px;  /* Reduced padding */
            background: var(--primary-color, #003366);
            color: white;
            border-radius: 6px;
            font-size: 1.3em;  /* Slightly smaller */
            font-weight: bold;
        }

        .events-at-time {
            flex: 1;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 12px;  /* Space between side-by-side events */
        }

        .event-card {
            background: #ffffff;
            color: #333333;
            border-radius: 8px;
            padding: 12px 15px;  /* Reduced from 20px */
            box-shadow: 0 3px 5px rgba(0, 0, 0, 0.15);
        }

        .event-title {
            font-size: 1.2em;  /* Reduced from 1.4em */
            font-weight: bold;
            margin-bottom: 4px;
            color: var(--primary-color, #003366);
            line-height: 1.3;
        }

        .event-opponent {
            font-size: 1em;
            font-weight: 600;
            color: #555;
            margin-bottom: 6px;
        }

        .event-location {
            font-size: 0.9em;  /* Reduced from 1em */
            color: #666;
            margin-bottom: 3px;
        }

        .event-location::before {
            content: "📍 ";
        }

        .event-address {
            font-size: 0.85em;  /* Reduced from 0.9em */
            color: #999;
            margin-top: 3px;
        }

        .event-address::before {
            content: "📍 ";
        }

        .event-level {
            font-size: 0.75em;
            font-weight: normal;
            color: #888;
            margin-left: 8px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .module-rotator {
            display: none;
        }

        .sidebar {
            display: none;
        }

        .main-content {
            width: 100%;
        }

        .schedule-header {
            display: flex;
            align-items: center;
            padding: 20px 30px;
            position: relative;
            background: #00284D;
            color: white;
            flex-shrink: 0;
        }

        .schedule-header h1 {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            margin: 0;
            font-size: 2.5em;
            font-weight: bold;
        }

        .schedule-header-logo {
            height: 90px;
            width: auto;
            background: white;
            border-radius: 8px;
            padding: 6px 10px;
        }

        .schedule-header-building {
            font-size: 1.6em;
            font-weight: bold;
            border: 3px solid white;
            border-radius: 8px;
            padding: 6px 16px;
            margin-left: auto;
        }

        html, body, .flex-layout, .main-content {
            height: 100%;
            margin: 0;
        }

        .main-content {
            display: flex;
            flex-direction: column;
        }

        #scheduleContainer {
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
            height: auto !important;
        }

        #scheduleContent {
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
        }

        .schedule-content {
            flex: 1;
            min-height: 0;
            overflow-y: auto;
        }

        #slideContainer.hidden {
            display: none !important;
        }

        #info-bar {
            align-self: flex-end;
            flex-shrink: 0;
            height: auto;
            width: 100%;
        }

        #info-weather img {
            margin-top: 8px;
        }

        .event-card.home {
            background: #e8f0f7;
        }

        .event-card.away {
            background: #fdf0f0;
        }

    </style>
</head>
<body>
    <div class="flex-layout">
        <div class="sidebar">
            <div class="module-rotator">
                <!-- Menu Module (if configured) -->
                <div class="rotating-module" id="menu-module-wrapper">
                    <h2>Today's Menu</h2>
                    <div data-module="menu"></div>
                </div>

                <!-- Calendar Module (if configured) -->
                <div class="rotating-module" id="calendar-module-wrapper">
                    <h2>Upcoming Events</h2>
                    <div data-module="calendar"></div>
                </div>
            </div>
            <div class="sidebar-header">
                <img src="/assets/OPS_banner_v1.png" alt="Orono Schools Logo" class="sidebar-logo">
                <h1 class="building-name">{BUILDING_NAME}</h1>
            </div>
        </div>

        <div class="main-content">
            <!-- Athletic Schedule (rotates with slides if slideId configured) -->
            <div class="schedule-container" id="scheduleContainer">
                <div class="loading-state" id="loadingState">
                    <div class="spinner"></div>
                    <h2>Loading Athletic Schedule...</h2>
                </div>

                <div class="error-state" id="errorState">
                    <div style="font-size: 3em; margin-bottom: 15px;">⚠️</div>
                    <h2>Unable to Load Schedule</h2>
                    <p>Please check your connection</p>
                </div>

                <div id="scheduleContent" style="display: none; height: 100%; display: flex; flex-direction: column;">
                    <div class="schedule-header">
                        <img src="/assets/OPS_banner_v1.png" alt="Orono Schools Logo" class="schedule-header-logo">
                        <h1>Athletic Schedule</h1>
                        <div class="schedule-header-building">{BUILDING_NAME}</div>
                    </div>
                    <div class="schedule-content" id="eventsList"></div>
                </div>
            </div>

            <!-- Slides (standard slideshow container) -->
            <div id="slideContainer"></div>

            <!-- Info bar at bottom -->
            <div id="info-bar">
                <div id="info-date"></div>
                <div id="info-weather"></div>
                <div id="info-time"></div>
            </div>
        </div>
    </div>

    <!-- Sidebar rotation script (from original template) -->
    <script>
        (() => {
            if (window.sidebarRotationIntervalId) {
                clearInterval(window.sidebarRotationIntervalId);
            }

            const rotationIntervalMs = 15000;
            const isMenuConfigured = "{BUILDING_CODE}" !== "";
            const isCalendarConfigured = "{GOOGLE_CALENDAR_URL}" !== "";

            const availableModules = [];
            if (isMenuConfigured) availableModules.push(document.getElementById('menu-module-wrapper'));
            if (isCalendarConfigured) availableModules.push(document.getElementById('calendar-module-wrapper'));

            if (availableModules.length < 2) {
                if (availableModules.length === 1) availableModules[0].style.display = 'flex';
                return;
            }

            let currentIdx = 0;

            const rotateModules = () => {
                availableModules.forEach(module => module.style.display = 'none');
                availableModules[currentIdx].style.display = 'flex';
                currentIdx = (currentIdx + 1) % availableModules.length;
            };

            rotateModules();
            window.sidebarRotationIntervalId = setInterval(rotateModules, rotationIntervalMs);
        })();
    </script>
</body>
</html>